PORT=3000
APP_URL=http://localhost:3000
CKO_API_BASE=https://api.sandbox.checkout.com
CKO_PUBLIC_KEY=replace_with_sandbox_public_key
CKO_SECRET_KEY=replace_with_sandbox_secret_key
CKO_PROCESSING_CHANNEL_ID=replace_with_part_2_processing_channel
# Disable shared-account risk rules for reproducible sandbox demonstrations.
ENABLE_RISK=false
# Keep false until onboarding/domain/device testing is complete.
ENABLE_APPLE_PAY=false
# Optional: webhook signing key, not the API secret key.
CKO_WEBHOOK_SECRET=
